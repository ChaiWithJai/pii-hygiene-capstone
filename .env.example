# ---------------------------------------------------------------------------
# Local (default, Docker) configuration. Copy to .env — no secrets required.
# ---------------------------------------------------------------------------
AIRFLOW_PORT=8088
STREAMLIT_PORT=8501
PII_BATCH_ID=local_dev_001
PII_DATA_DIR=/opt/pii/data

# Local warehouse (Postgres 16 in Docker). Port 5433 on the host.
PII_DB_HOST=warehouse
PII_DB_PORT=5432
PII_DB_NAME=pii_lab
PII_DB_USER=pii_admin
PII_DB_PASSWORD=pii_admin_pw

# Host-side runs (scripts/run_local_pipeline.sh) use 127.0.0.1:5433
PII_DB_HOST_LOCAL=127.0.0.1
PII_DB_PORT_LOCAL=5433

# Detector limits (keep the evaluation CPU-friendly)
PII_EVAL_MAX_DOCS=4000
PII_EVAL_BOOTSTRAP=1000
PII_AGENT_MAX_ACTIONS=40
PII_QUARANTINE_THRESHOLD=0.05

# Optional: opening a sandbox GitHub Issue from the triage agent.
# Leave empty to keep all state changes inside the local warehouse.
SANDBOX_GITHUB_REPO=
SANDBOX_GITHUB_TOKEN=

# Optional: real Hugging Face corpora download (needs `hf` CLI + accepted terms).
# The pipeline works fully offline with the committed synthetic fixture mode.
HF_TOKEN=
